# ── LLM ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Bridge ports ───────────────────────────────────────────────────────────────
# Flask bridge server (bridge/bridge_server.py)
FLASK_PORT=5050

# ── Logging ───────────────────────────────────────────────────────────────────
# Node.js Baileys log level: silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=warn
